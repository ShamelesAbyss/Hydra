# ============================================================
# HYDRA · example environment configuration  (v1.4.3+)
# ============================================================
# Single-venue: Hyperliquid mainnet. Copy to `.env` and fill secrets.

ENABLE_LIVE_TRADING=false

# Hyperliquid (mainnet only)
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=

DEFAULT_RISK_PCT=0.75
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=8.0
MAX_DRAWDOWN_PCT=15.0
MAX_CONSECUTIVE_LOSSES=4
# v1.3.4 rolling window for the consec-loss circuit breaker (hours).
# Losses older than this auto-expire so the bot can never deadlock itself.
CONSECUTIVE_LOSS_WINDOW_HOURS=4
MAX_OPEN_EXPOSURE_PCT=40.0
MAX_NOTIONAL_PER_MARKET_USD=2500
MIN_LIQUIDITY_USD=50000
MAX_SPREAD_BPS=25
MAX_SLIPPAGE_BPS=30

COMPOUND_REINVEST_PCT=50.0
COMPOUND_LOCK_PCT=25.0
COMPOUND_MIN_PROFIT_USD=25
COMPOUND_DRAWDOWN_REDUCE_PCT=40.0

LOG_LEVEL=info
DATA_DIR=./data
LOG_DIR=./logs
DB_PATH=./data/hydra.db
POLL_INTERVAL_MS=1500
SHUTDOWN_MODE=keep_open
